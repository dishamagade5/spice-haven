# Copy to .env in backend/restont/ and set values before starting Spring Boot.
# The backend also accepts the legacy RAZORPAY_API_KEY and RAZORPAY_API_SECRET
# environment variable names for compatibility with existing deployments.
DB_URL=jdbc:mysql://localhost:3306/spicehaven?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
# Optional for persistent tokens across restarts or multiple backend instances.
# If omitted, the backend generates a secure process-local signing key.
# SPICEHAVEN_JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
SPICEHAVEN_JWT_EXPIRY_MINUTES=120
SPICEHAVEN_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Dish images are stored in the database and mirrored to this directory.
SPICEHAVEN_MENU_IMAGE_DIRECTORY=uploads/dishes
SPICEHAVEN_ADMIN_EMAIL=admin@gmail.com
SPICEHAVEN_ADMIN_PASSWORD=
# Optional WhatsApp number for order notifications.
SPICEHAVEN_WHATSAPP_NUMBER=
# Razorpay test/live API credentials (keep the secret backend-only).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
